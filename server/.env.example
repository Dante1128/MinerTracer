# Copie este archivo como .env y ajuste los valores.

PORT=3000

# PostgreSQL. Si se deja vacío, se usa PGlite (PostgreSQL embebido) en DATOS_DIR/pglite.
# DATABASE_URL=postgres://postgres:CONTRASEÑA@localhost:5432/minertrace

# Carpeta para PGlite y los PDFs.
DATOS_DIR=./datos

# Obligatorio en producción.
JWT_SECRET=cambie-esto-por-un-valor-largo-y-aleatorio

# Proveedor de anclaje: "mock" (simulado, sin red) o "stellar" (contrato Soroban en testnet).
ANCLAJE=mock
# Latencia simulada de la red y probabilidad de fallo (0 a 1) para probar reintentos (solo mock).
MOCK_RETRASO_MS=2500
MOCK_TASA_FALLO=0

# --- ANCLAJE=stellar (solo testnet) ---------------------------------------
# Contrato desplegado con `npm run contrato:desplegar` (imprime el CONTRACT_ID).
# STELLAR_CONTRATO_ID=CBPILW6WNKGUOYEFIR5MZPGYG2GMWMMMTYO27KY43VNR7JJ6TQ5GYK5W
# RPC de Soroban (por defecto, el público de testnet).
# STELLAR_RPC_URL=https://soroban-testnet.stellar.org
#
# Clave secreta de cada laboratorio: STELLAR_SECRETO_<ID con guiones bajos>.
# TEMPORAL hasta la etapa 4 (el laboratorio firmará con su wallet). Las del
# script de despliegue se obtienen con:
#   stellar keys secret minertrace-lab-a   (LAB-001)
#   stellar keys secret minertrace-lab-b   (LAB-002)
# Nunca suba estas claves al repositorio.
# STELLAR_SECRETO_LAB_001=S...
# STELLAR_SECRETO_LAB_002=S...
#
# Dueño del lote de ejemplo de la semilla (opcional): `stellar keys public-key minertrace-vendedor`.
# STELLAR_DUENO_DEMO=G...

# Habilita el botón "Simular fraude" (se ignora con NODE_ENV=production).
DEMO_ALTERAR=true
