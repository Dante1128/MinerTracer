# Copie este archivo como .env y ajuste los valores.

PORT=3000

# PostgreSQL. Si se deja vacío, se usa PGlite (PostgreSQL embebido) en DATOS_DIR/pglite.
# DATABASE_URL=postgres://postgres:CONTRASEÑA@localhost:5432/minertrace

# Carpeta para PGlite y los PDFs.
DATOS_DIR=./datos

# Obligatorio en producción.
JWT_SECRET=cambie-esto-por-un-valor-largo-y-aleatorio

# Proveedor de anclaje: "mock" (simulado, sin red) o "stellar" (contrato Soroban en testnet).
ANCLAJE=mock
# Latencia simulada de la red y probabilidad de fallo (0 a 1) para probar reintentos (solo mock).
MOCK_RETRASO_MS=2500
MOCK_TASA_FALLO=0

# --- ANCLAJE=stellar (solo testnet) ---------------------------------------
# Contrato desplegado con `npm run contrato:desplegar` (imprime el CONTRACT_ID).
# STELLAR_CONTRATO_ID=CAHKMOKFXWD3OTMT45SBLSWHCN7Y2PPQVZJIL6VBQYIMW3ZH22XVQFYK
# RPC de Soroban (por defecto, el público de testnet).
# STELLAR_RPC_URL=https://soroban-testnet.stellar.org
#
# Quién firma los análisis y contra-análisis del portal:
#   wallet   (por defecto) el laboratorio firma con Freighter; el servidor solo
#            envía, comprueba el contrato y reconcilia.
#   servidor el servidor firma con STELLAR_SECRETO_* (desarrollo sin Freighter).
# FIRMA_LABORATORIO=wallet
#
# Cuenta pública de cada laboratorio semilla: STELLAR_CUENTA_<ID con guiones bajos>.
# Con firma por wallet basta la cuenta pública (la clave queda en Freighter).
# STELLAR_CUENTA_LAB_001=G...
# STELLAR_CUENTA_LAB_002=G...
#
# Clave secreta de un laboratorio (opcional): solo para que el servidor firme el
# análisis de la semilla, las pruebas de testnet o FIRMA_LABORATORIO=servidor.
# Las del script de despliegue: stellar keys secret minertrace-lab-a (LAB-001)
# y minertrace-lab-b (LAB-002). Nunca suba estas claves al repositorio.
# STELLAR_SECRETO_LAB_001=S...
# STELLAR_SECRETO_LAB_002=S...
#
# Dueño del lote de ejemplo de la semilla (opcional): `stellar keys public-key minertrace-vendedor`.
# STELLAR_DUENO_DEMO=G...

# Habilita el botón "Simular fraude" (se ignora con NODE_ENV=production).
DEMO_ALTERAR=true
