# Copie este archivo como .env y ajuste los valores.

PORT=3000

# PostgreSQL. Si se deja vacío, se usa PGlite (PostgreSQL embebido) en DATOS_DIR/pglite.
# DATABASE_URL=postgres://postgres:CONTRASEÑA@localhost:5432/minertrace

# Carpeta para PGlite y los PDFs.
DATOS_DIR=./datos

# Obligatorio en producción: al menos 32 caracteres aleatorios; no use este ejemplo.
# Conserva el nombre histórico: ahora protege CSRF, límites y correos, sin emitir JWT.
JWT_SECRET=cambie-esto-por-un-valor-largo-y-aleatorio

# Origen exacto del portal, sin barra final. Obligatorio con HTTPS en producción.
ORIGEN_PUBLICO=http://localhost:5173
# IP o CIDR de los proxies que realmente controlamos, separados por comas.
# El proxy debe reemplazar X-Forwarded-For. Vacío: no se confía en esa cabecera.
# PROXIES_CONFIABLES=127.0.0.1/32,::1/128

# Correo de invitaciones y recuperación. Obligatorio en producción.
# Use el mismo JWT_SECRET en todas las instancias: protege CSRF, límites y correos en cola.
SMTP_HOST=
SMTP_PORT=587
# true para TLS directo (habitualmente puerto 465); false para STARTTLS (587).
SMTP_SECURE=false
SMTP_USUARIO=
SMTP_CLAVE=
SMTP_REMITENTE=
# En desarrollo puede usar un servidor local como Mailpit (puerto 1025).

# Proveedor de anclaje: "mock" (simulado, sin red) o "stellar" (contrato Soroban en testnet).
ANCLAJE=mock
# Latencia simulada de la red y probabilidad de fallo (0 a 1) para probar reintentos (solo mock).
MOCK_RETRASO_MS=2500
MOCK_TASA_FALLO=0

# --- ANCLAJE=stellar (solo testnet) ---------------------------------------
# Contrato desplegado con `npm run contrato:desplegar` (imprime el CONTRACT_ID).
# STELLAR_CONTRATO_ID=CAHKMOKFXWD3OTMT45SBLSWHCN7Y2PPQVZJIL6VBQYIMW3ZH22XVQFYK
# RPC de Soroban (por defecto, el público de testnet).
# STELLAR_RPC_URL=https://soroban-testnet.stellar.org
#
# Quién firma los análisis y contra-análisis del portal:
#   wallet   (por defecto) el laboratorio firma con Freighter; el servidor solo
#            envía, comprueba el contrato y reconcilia.
#   servidor el servidor firma con STELLAR_SECRETO_* (desarrollo sin Freighter).
# FIRMA_LABORATORIO=wallet
#
# Cuenta pública de cada laboratorio semilla: STELLAR_CUENTA_<ID con guiones bajos>.
# Con firma por wallet basta la cuenta pública (la clave queda en Freighter).
# STELLAR_CUENTA_LAB_001=G...
# STELLAR_CUENTA_LAB_002=G...
#
# Clave secreta de un laboratorio (opcional): solo para que el servidor firme el
# análisis de la semilla, las pruebas de testnet o FIRMA_LABORATORIO=servidor.
# Las del script de despliegue: stellar keys secret minertrace-lab-a (LAB-001)
# y minertrace-lab-b (LAB-002). Nunca suba estas claves al repositorio.
# STELLAR_SECRETO_LAB_001=S...
# STELLAR_SECRETO_LAB_002=S...
#
# Dueño del lote de ejemplo de la semilla (opcional): `stellar keys public-key minertrace-vendedor-potosi`.
# El vendedor `minertrace-vendedor` se conserva para la demo comercial v2 de dos lotes.
# STELLAR_DUENO_DEMO=G...

# --- Comercio v2: variables del lanzador y del script de despliegue -------
# ID público opcional para `npm run dev:comercio` (por defecto scripts/comercio-testnet.json).
# Ese comando crea/reutiliza un DATOS_DIR
# independiente por contrato, fuerza PGlite y no modifica este archivo ni borra datos.
# COMERCIO_CONTRATO_ID=C...
# Las siguientes opciones se exportan al entorno de `npm run contrato:desplegar`.
# Son parámetros del despliegue; la API consulta su valor efectivo en el contrato.
# Token de un contrato existente (tiene prioridad sobre TOKEN_NATIVO).
# TOKEN_CONTRATO=C...
# Por defecto se conserva XLM testnet. Solo TOKEN_NATIVO=false crea un activo USDC SINTÉTICO
# emitido por minertrace-usdc en TESTNET; no es USDC real ni representa dólares.
# Al desplegarlo, prepara líneas de confianza para vendedores, comprador y plataforma.
# Una plataforma externa debe autorizar su propia línea de confianza antes del despliegue.
# La demo `demo:comercio` de 2000 XLM exige el contrato XLM; no ejecutarla sobre este token distinto.
# TOKEN_NATIVO=true
# Tiempo máximo de entrega desde la financiación (por defecto 24 horas).
# PLAZO_ENTREGA_SEG=86400
# Plazo de inspección desde la recepción acreditada (por defecto 7 días).
# PLAZO_GARANTIA_DIAS=7
# PLAZO_GARANTIA_SEG=604800
# Comisión comprador: 1 %, con mínimo en unidades del TOKEN de pago, nunca Bs implícitos.
# COMISION_MINIMA_TOKEN=20
# Ayuda al ensayo: hasta 0,25 % del precio, limitada por coste acreditado y este tope en TOKEN.
# REINTEGRO_MAXIMO_TOKEN=100
# Dirección pública que recibirá la comisión neta al completar la venta (por defecto admin).
# DESTINATARIO_PLATAFORMA=G...
# El poblado histórico `demo:poblar` usa seis identidades CLI para el directorio. Opcionalmente
# puede sustituirlas con secretos locales; nunca copie valores reales a este archivo de ejemplo.
# DEMO_SECRETO_VENDEDOR_HUANUNI=S...
# DEMO_SECRETO_VENDEDOR_POTOSI=S...
# DEMO_SECRETO_VENDEDOR_TIPUANI=S...
# DEMO_SECRETO_VENDEDOR_SANSIMON=S...
# DEMO_SECRETO_VENDEDOR_COLQUIRI=S...
# DEMO_SECRETO_VENDEDOR_CHOJLLA=S...

# Habilita el botón "Simular fraude" (se ignora con NODE_ENV=production).
DEMO_ALTERAR=true
