# Copie este archivo como .env y ajuste los valores.

PORT=3000

# PostgreSQL. Si se deja vacío, se usa PGlite (PostgreSQL embebido) en DATOS_DIR/pglite.
# DATABASE_URL=postgres://postgres:CONTRASEÑA@localhost:5432/minertrace

# Carpeta para PGlite y los PDFs.
DATOS_DIR=./datos

# Obligatorio en producción.
JWT_SECRET=cambie-esto-por-un-valor-largo-y-aleatorio

# Proveedor de anclaje: "mock" en Fase 1. En Fase 2: "stellar".
ANCLAJE=mock
# Latencia simulada de la red y probabilidad de fallo (0 a 1) para probar reintentos.
MOCK_RETRASO_MS=2500
MOCK_TASA_FALLO=0

# Habilita el botón "Simular fraude" (se ignora con NODE_ENV=production).
DEMO_ALTERAR=true
